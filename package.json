{
	"name": "paraframe",
	"version": "0.1.0",
	"description": "A read-only viewer for navigating and arranging UI frames, in the style of a design tool's prototype preview.",
	"license": "UNLICENSED",
	"type": "module",
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "svelte-kit sync && svelte-package --watch",
		"package": "svelte-kit sync && svelte-package && publint",
		"showcase": "vite dev",
		"build": "vite build && pnpm package",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "pnpm package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"svelte": "^5.57.1",
		"tailwindcss": "^4.3.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@^7.0.2",
		"publint": "^0.3.21",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.0"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"prototype",
		"frames"
	],
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"visual-comments": "link:../visual-comments/packages/client"
	}
}
