{
	"name": "paraframe",
	"version": "0.1.0",
	"description": "Click through Svelte prototypes like a Figma file: real Svelte components as frames, on a zoomable canvas and in a flow player.",
	"keywords": [
		"svelte",
		"sveltekit",
		"svelte5",
		"prototype",
		"prototyping",
		"prototype-viewer",
		"canvas",
		"infinite-canvas",
		"design-tools",
		"figma",
		"frames"
	],
	"homepage": "https://paraframe.convex.works",
	"bugs": "https://github.com/Convex-Works/paraframe/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Convex-Works/paraframe.git"
	},
	"license": "MIT",
	"author": "Convex Works",
	"type": "module",
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "svelte-kit sync && svelte-package --watch",
		"package": "svelte-kit sync && svelte-package && publint",
		"showcase": "vite dev",
		"build": "vite build && pnpm package",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "pnpm package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"test": "vitest run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./comments": {
			"types": "./dist/comments.d.ts",
			"svelte": "./dist/comments.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"svelte": "^5.57.1",
		"tailwindcss": "^4.3.0",
		"visual-comments": "^0.1.0"
	},
	"peerDependenciesMeta": {
		"visual-comments": {
			"optional": true
		}
	},
	"devDependencies": {
		"@convex-works/sign-in": "link:../sign-in",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@^7.0.2",
		"happy-dom": "^21.0.3",
		"publint": "^0.3.21",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.3",
		"visual-comments": "^0.1.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
